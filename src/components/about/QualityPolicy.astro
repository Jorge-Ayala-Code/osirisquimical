---
import { getLangHelpers } from '../../i18n/utils';

const { t, lang } = getLangHelpers(Astro.currentLocale);
---
<div class="max-w-7xl mx-auto px-4 flex flex-col items-center text-center">
  <div class="mb-8 flex items-center justify-center w-20 h-20 rounded-full bg-hc-banner text-hc-primary border-4 border-hc-primary/20 shadow-lg">
    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      <path d="m9 12 2 2 4-4"/>
    </svg>
  </div>
  <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-hc-text uppercase">
    {t('qualityPolicy_Title')}
  </h2>
</div>
<div class="text-left py-6">
  <p class="text-xl md:text-2xl leading-relaxed text-hc-secondary-text italic mb-8">
    {t('qualityPolicy_Text1')} <span class="font-bold not-italic text-hc-primary uppercase tracking-tight">Horus Chemical</span> {t('qualityPolicy_Text2')}
  </p>
  <div class="h-px w-full bg-hc-primary/30 mb-8"></div>
  <p class="text-xl md:text-2xl leading-relaxed text-hc-secondary-text italic mb-8">
    {t('qualityPolicy_Text3')} <strong class="text-hc-text font-semibold">{t('qualityPolicy_Text4')}</strong> {t('qualityPolicy_Text5')} <strong class="text-hc-text font-semibold">{t('qualityPolicy_Text6')}</strong>, {t('qualityPolicy_Text7')}
  </p>
</div>
