---
import { getLangHelpers } from '../../i18n/utils';

const { t, l, lang } = getLangHelpers(Astro.currentLocale);
---

<div class="flex flex-col lg:flex-row gap-12 lg:items-center">
  <div class="w-full lg:w-1/3 flex flex-col items-center lg:items-start gap-8">
    <div class="relative group/badge">
      <div class="absolute -inset-4 border border-hc-primary/20 rounded-full animate-[spin_10s_linear_infinite] group-hover/badge:border-hc-primary/40 transition-colors"></div>
        <div class="relative w-48 h-48 rounded-full bg-white shadow-2xl flex items-center justify-center z-10 transition-transform duration-500 group-hover/badge:rotate-12 overflow-hidden">
          <a 
            href="https://www.iafcertsearch.org/certified-entity/MWmdwINoupwLPxQq9n8MXc2L" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full h-full flex items-center justify-center">
            <img 
              src="/images/iso/ISO9001.webp" 
              alt="Logo de Certificación ISO" 
              class="w-full h-full object-cover"/>
          </a>
        </div>
      <div class="absolute inset-0 bg-hc-primary/10 rounded-full blur-2xl -z-10 group-hover/badge:bg-hc-primary/20 transition-all"></div>
    </div>
  </div>
  <div class="w-full lg:w-2/3">
    <h3 class="text-3xl md:text-4xl font-extrabold tracking-tight text-hc-text mb-8 italic">
      {t('cert_title')}
    </h3>
    <div class="space-y-6">
      <p class="text-xl leading-relaxed text-hc-secondary-text">
        <strong class="text-hc-text font-bold uppercase tracking-tight">{t('name')}</strong> {t('cert_p1_part1')}
        <span class="inline-block bg-hc-primary/5 px-2 py-1 rounded border-b-2 border-hc-primary text-hc-primary font-bold">
          ISO-9001:2015
        </span>{t('cert_p1_part2')}
      </p>
      <div class="relative p-6 bg-gray-50 rounded-2xl border-l-8 border-hc-primary shadow-sm">
        <p class="text-lg md:text-xl font-medium text-hc-text leading-snug italic">
          {t('cert_quote')}
        </p>
      </div>
    </div>
  </div>
</div>