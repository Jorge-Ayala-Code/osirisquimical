---
interface Props {
  id?: string;
  href?: string;
  targetId?: string;
  class?: string;
  action?: 'menu' | 'scroll' | 'lang-selector' | 'none';
  type?: 'button' | 'submit' | 'reset';
  [key: string]: any;
}

const { 
  id,
  href,
  targetId, 
  class: className = "", 
  action = "none",
  type = "button",
  ...rest
} = Astro.props;

const scrollClass = action === 'scroll' ? 'scroll-button' : '';
const langClass = action === 'lang-selector' ? 'lang-button' : '';
---

{
  href ? (
    <a 
      id={id}
      href={href} 
      class:list={[className]} 
      {...rest}>
      <slot />
    </a>
  ) : (
    <button 
      id={id}
      type={type}
      data-target={targetId} 
      data-action={action}
      class:list={[className, scrollClass, langClass]}
      {...rest}>
      <slot />
    </button>
  )
}

<script>
  const initGlobalEvents = () => {
    if ((window as any).buttonsInitialized) return; 
    document.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest('[data-action="menu"]');
      if (!button) return;
      const targetId = button.getAttribute('data-target');
      const mobileMenu = targetId ? document.getElementById(targetId) : null;
      if (mobileMenu) {
        mobileMenu.classList.toggle('opacity-100');
        mobileMenu.classList.toggle('translate-y-0');
        mobileMenu.classList.toggle('pointer-events-none');
        const icons = button.querySelectorAll('.menu-icon');
        icons.forEach(icon => icon.classList.toggle('hidden'));
      }
    });
    document.addEventListener('click', (e) => {
       const button = (e.target as HTMLElement).closest('[data-action="scroll"]');
       if (!button) return;
       const targetId = button.getAttribute('data-target');
       const targetElement = targetId ? document.getElementById(targetId) : null;
       
       if (targetElement) {
         targetElement.scrollIntoView({ behavior: 'smooth' });
       }
    });
    (window as any).buttonsInitialized = true;
  };
  initGlobalEvents();
  document.addEventListener('astro:page-load', initGlobalEvents);
</script>