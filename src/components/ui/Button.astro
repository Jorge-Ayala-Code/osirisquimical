---
interface Props {
  targetId?: string;
  class?: string;
  action?: 'menu' | 'scroll' | 'none';
  type?: 'button' | 'submit' | 'reset';
}

const { 
  targetId, 
  class: className = "", 
  action = "none",
  type = "button" 
} = Astro.props;
---

<button 
  type={type}
  data-target={targetId} 
  data-action={action}
  class:list={[className]}> 
  <slot />
</button>

<script>
  document.addEventListener("DOMContentLoaded", () => {
  const menuButtons = document.querySelectorAll('[data-target]');
  menuButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const targetId = button.getAttribute('data-target');
      if (!targetId) return;
      const mobileMenu = document.getElementById(targetId);
      if (!mobileMenu) return;
      mobileMenu.classList.toggle('opacity-100');
      mobileMenu.classList.toggle('translate-y-0');
      mobileMenu.classList.toggle('pointer-events-none');
      const icons = button.querySelectorAll('.menu-icon');
      icons.forEach(icon => {
        icon.classList.toggle('hidden');
      });
    });
  });
});

const initScroll = () => {
  const scrollButtons = document.querySelectorAll<HTMLButtonElement>('.scroll-button');
  scrollButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const targetId = button.getAttribute('data-target');
        if (!targetId) return;
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          targetElement.scrollIntoView({ 
            behavior: 'smooth',
            block: 'start' 
        });
      }
    });
  });
};
document.addEventListener('astro:page-load', initScroll);
document.addEventListener('DOMContentLoaded', initScroll);
</script>