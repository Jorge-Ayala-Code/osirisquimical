---
interface Props {
  id?: string;
  class?: string;
}

const { 
  id, 
  class: className 
} = Astro.props;
---
<section id={id} class:list={["bg-hc-background min-h-screen flex items-center py-12", className]}>
  <div class="relative mx-auto max-w-225 py-16 px-4 w-full">
    <slot />
  </div>
</section>