---
import sprite from "../../assets/icons/spritecss.svg?url";
import Button from "../ui/Button.astro";

const CrossOut = "--x: 50%; --y: 100%;";
const Burger = "--x: 100%; --y: 100%;";

const maskBase = 
`mask-image: url(${sprite}); 
-webkit-mask-image: url(${sprite}); 
mask-size: 300% 300%; 
-webkit-mask-size: 300% 300%; 
mask-repeat: no-repeat; 
-webkit-mask-repeat: no-repeat; 
mask-position: var(--x) var(--y); 
-webkit-mask-position: var(--x) var(--y);`;

const menu = [
  { href: "/about", name: "Nosotros" },
  { href: "/products", name: "Productos" },
  { href: "/services", name: "Servicios" },
  { href: "/contact", name: "Contacto" }
];
---
 
<nav class="container max-w-225 mx-auto px-4 h-16 flex items-center justify-between">
  <a href="/" id="header-logo" class="flex items-center">
    <img 
      src="../src/assets/images/Logo-Horus.svg" 
      alt="Horus Chemical Logo" 
      class="h-8 w-auto md:h-12 transition-all"/>
  </a>
  <ul id="nav-menu" class="hidden text-hc-text md:flex space-x-8 font-medium">
    {menu.map((item) => (
      <li><a href={item.href} class="hover:text-hc-secondary transition">{item.name}</a></li>
    ))}
  </ul>
  <div id="mobile-menu" class="absolute top-21 min-h-screen left-0 w-full bg-white/90 backdrop-blur-lg border-b border-gray-200 shadow-lg md:hidden pointer-events-none opacity-0 -translate-y-4 transition-all duration-300 ease-out">
    <ul class="flex flex-col p-2 space-y-7 m-7 text-lg font-medium text-hc-text">
      {menu.map((item) => (
        <li><a href={item.href} class="block pb-2">{item.name}</a></li>
      ))}
    </ul>
  </div>
  <Button targetId="mobile-menu" action="menu" class="md:hidden flex items-center justify-center">
    <div 
      id="menu-icon-burger"
      class="menu-icon w-7 h-7 bg-current transition-colors duration-300" 
      style={`${maskBase} ${Burger}`}>
    </div>
    <div 
      id="menu-icon-close"
      class="menu-icon w-7 h-7 bg-current hidden transition-colors duration-300" 
      style={`${maskBase} ${CrossOut}`}>
    </div>
  </Button>
</nav>