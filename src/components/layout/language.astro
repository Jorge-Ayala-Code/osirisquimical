---
import Button from "../ui/Button.astro";

const { currentPath = "/" } = Astro.props;
function getTransformedPath(targetLang: string) {
  const segments = currentPath.split('/').filter(Boolean);
  const hasLangPrefix = segments[0] === 'es' || segments[0] === 'en';
  if (hasLangPrefix) {
    if (targetLang === 'en') {
      segments[0] = 'en';
    } else {
      segments.shift();
    }
  } else {
    if (targetLang === 'en') {
      segments.unshift('en');
    }
  }
  const finalPath = `/${segments.join('/')}`;
  return finalPath === '' ? '/' : finalPath;
}
---

<li class="relative group ml-4 border-l border-white/20 pl-4">
  <Button 
    action="lang-selector" 
    class="flex items-center gap-2 hover:text-hc-secondary transition py-6">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
    <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </Button>
  <div class="absolute top-full right-0 w-32 bg-hc-desing/90 backdrop-blur-md shadow-xl rounded-b-xl opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300 z-50 overflow-hidden border border-white/10">
    <div class="flex flex-col text-sm">
      <a href={getTransformedPath('es')} class="px-4 py-3 text-hc-text hover:bg-hc-secondary/20 hover:text-hc-secondary transition-colors flex justify-between items-center">
        Español <span class="opacity-50">ES</span>
      </a>
      <a href={getTransformedPath('en')} class="px-4 py-3 text-hc-text hover:bg-hc-secondary/20 hover:text-hc-secondary transition-colors flex justify-between items-center">
        English <span class="opacity-50">EN</span>
      </a>
    </div>
  </div>
</li>
