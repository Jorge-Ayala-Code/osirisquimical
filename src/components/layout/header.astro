      <li><a href="/contacto" class="hover:text-green-600 transition">Contacto</a></li>
    </ul>
    <div id="mobile-menu" class="hidden absolute top-16 left-0 w-full bg-white border-b border-gray-200 shadow-lg md:hidden">
