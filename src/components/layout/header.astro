---
import Button from "../ui/Button.astro";
---

<header class="bg-white shadow-md border-b border-gray-200 sticky top-0 z-50">
  <nav class="container mx-auto px-4 h-16 flex items-center justify-between">
    <a  class="flex items-center">
      <img src="../src/assets/images/Horus.png" alt="Horus Chemical Logo" class="h-8 w-auto md:h-12 transition-all"/>
    </a>
    <ul class="hidden md:flex space-x-8 text-gray-600 font-medium">
      <li><a href="/about" class="hover:text-green-600 transition">Nosotros</a></li>
