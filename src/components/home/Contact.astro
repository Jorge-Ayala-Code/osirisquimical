---
import sprite from "../../assets/icons/spritecss.svg?url";
import EmailSuccessfulMessage from "../ui/EmailSuccessfulMessage.astro";
import Form from "../ui/Form.astro";
import { getLangHelpers } from '../../i18n/utils';

const { t, l, lang } = getLangHelpers(Astro.currentLocale);

const location = `--x: 0%; --y: 100%;`;
const maskBase = `mask-image: url(${sprite}); -webkit-mask-image: url(${sprite}); mask-size: 300% 300%; -webkit-mask-size: 300% 300%; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat;`;

const contact = [
  { name: "Nombre del cliente", maxlength: "72.1%", left: "58.1%" },
  { name: "Correo de contacto", maxlength: "52.5%", left: "55.5%" },
  { name: "Telefono de enlace", maxlength: "64.8%", left: "54.1%" },
  { name: "Empresa de consulta", maxlength: "65.3%", left: "57.9%" },
];

const servvice = [
  { name: "Estado de México", maxlength: "72.1%", left: "58.1%" },
  { name: "San Luis Potosí", maxlength: "52.5%", left: "55.5%" },
  { name: "Guanajuato", maxlength: "64.8%", left: "54.1%" },
  { name: "Querétaro", maxlength: "65.3%", left: "57.9%" },
];

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<div class="group/section overflow-hidden">
  <div class="max-w-2xl text-center mx-auto mb-10 ">
    <h3 class="text-3xl font-bold tracking-tight text-hc-text sm:text-4xl">
      {title}
    </h3>
  </div>
  <div class="flex flex-col gap-10 lg:flex-row lg:items-start">
    <div class="w-full lg:w-1/2">
      <Form service="contact" />
      <EmailSuccessfulMessage />
    </div>
    <div class="flex flex-col items-center w-full lg:w-1/2 gap-6">
      <div class="w-full h-80 lg:h-86 rounded-2xl overflow-hidden shadow-xl border border-hc-banner group/map">
      <iframe 
        title="Ubicación" 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3760.121508215573!2d-99.2729479247833!3d19.582112!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTnvsCgzNCc1NS42Ik4gOTnCsDE2JzEzLjMiVw!5e0!3m2!1ses!2smx!4v1710000000000!5m2!1ses!2smx" 
        width="100%" 
        height="100%" 
        class="transition-all duration-900" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy">
      </iframe>
      </div>
      <div class="flex items-center gap-4 p-4 bg-hc-primary/5 rounded-xl w-full border border-hc-primary/10">
        <div class="w-7 h-7 text-hc-primary shrink-0 bg-current" style={`${maskBase} mask-position: var(--x) var(--y); -webkit-mask-position: var(--x) var(--y); ${location}`}></div>
        <p class="text-sm md:text-base text-hc-text font-medium">Tamaulipas 11, Adolfo Lopez Mateos, 00000 Cdad. López Mateos, Méx.</p>
      </div>
    </div>
  </div>
</div>