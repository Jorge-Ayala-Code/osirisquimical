---
import sprite from "../../assets/icons/spritecss.svg?url";
import Button from "../ui/Button.astro";

const ChevronDown = "--x: 100%; --y: 50%;";

const maskBase = `mask-image: url(${sprite}); 
-webkit-mask-image: url(${sprite}); 
mask-size: 300% 300%; 
-webkit-mask-size: 300% 300%; 
mask-repeat: no-repeat; 
-webkit-mask-repeat: no-repeat;`;
---

<section class="grow flex relative items-center overflow-hidden min-h-screen py-full sm:py-full justify-center">
  <div class="absolute inset-0 bg-white/50 z-10"></div>
  <img
    src='../src/assets/images/hero.webp'
    class="absolute inset-0 z-0 h-full w-full object-cover object-right"/>
  <div class="flex flex-col">
    <div class="relative z-10 max-w-7xl px-6 text-hc-text lg:px-8">
      <div class="max-w-2xl mx-auto">
        <h1 class="text-4xl text-center font-bold tracking-tight sm:text-6xl ">
          Inovación Química para un Futuro Sostenible
        </h1>
      </div>
    </div>
    <div class="relative z-10 max-w-7xl px-6 lg:px-8 mt-15">
      <div class="max-w-2xl mx-auto flex flex-col items-center text-hc-text ">
        Ver más
        <Button 
          targetId="welcome"
          action="scroll"
          class="text-hc-primary scroll-button hover:scale-110 transition-transform">
          <div 
            class="w-8 h-8 bg-current inline-block" 
            style={`${maskBase} mask-position: var(--x) var(--y); -webkit-mask-position: var(--x) var(--y); ${ChevronDown}`}>
          </div>
        </Button>
      </div>
    </div>
  </div>
</section>