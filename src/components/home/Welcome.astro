---
import Button from "../ui/Button.astro";
import { getLangHelpers } from '../../i18n/utils';
const { t, l } = getLangHelpers(Astro.currentLocale);
---

<h2 class="text-3xl font-bold tracking-tight text-hc-text sm:text-4xl">
  {t('welcome_title1')}<span class='text-hc-primary'>{t('name')}</span>{t('welcome_title2')}
</h2>
<p class="mt-6 text-xl leading-8 text-hc-secondary-text">
  {t('welcome_subtitle')}
</p>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
  <div class="p-4 border-l-4 border-hc-primary bg-white">
    <h3 class="font-bold text-hc-text">{t('welcome_card1_title')}</h3>
    <p class="text-hc-secondary-text text-sm">{t('welcome_card1_text')}</p>
  </div>
  <div class="p-4 border-l-4 border-hc-primary bg-white">
    <h3 class="font-bold text-hc-text">{t('welcome_card2_title')}</h3>
    <p class="text-hc-secondary-text text-sm">{t('welcome_card2_text')}</p>
  </div>
  <div class="p-4 border-l-4 border-hc-primary bg-white">
    <h3 class="font-bold text-hc-text">{t('welcome_card3_title')}</h3>
    <p class="text-hc-secondary-text text-sm">{t('welcome_card3_text')}</p>
  </div>
  <div class="p-4 border-l-4 border-hc-primary bg-white">
    <h3 class="font-bold text-hc-text">{t('welcome_card4_title')}</h3>
    <p class="text-hc-secondary-text text-sm">{t('welcome_card4_text')}</p>
  </div>
</div>
<div class="mt-10 p-6 bg-hc-banner rounded-xl">
  <p class="text-lg font-medium text-hc-text italic">
    {t('welcome_banner_italic')}
  </p>
  <p class="mt-4 text-hc-secondary-text">
    {t('welcome_banner_p')}
  </p>
</div>
<div class="flex flex-col sm:flex-row gap-4 w-full mt-10">
  <Button 
    href={l("/products")}
    class="w-full bg-hc-primary hover:bg-hc-secondary text-white relative z-10 text-center py-4 rounded-md font-semibold shadow-md">
    {t('welcome_btn_products')}
  </Button>
  <Button 
    href={l("/services")}
    class="w-full bg-hc-primary hover:bg-hc-secondary text-white relative z-10 text-center py-4 rounded-md font-semibold shadow-md">
    {t('welcome_btn_services')}
  </Button>
</div>