---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import EmailSuccessfulMessage from "../../components/ui/EmailSuccessfulMessage.astro";
import Form from "../../components/ui/Form.astro";
import { getLangHelpers } from '../../i18n/utils';

const { t, lang } = getLangHelpers(Astro.currentLocale);
---

<MainLayout>
  <Hero 
    id="services"
    img='/images/heros/hero-services2.webp' 
    title={(t('services'))} />
  <Section id="services">
    <div class="services-section group/section py-2 overflow-hidden" data-visible="false">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16">
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-hc-text mb-6">
            {t('services_title')} <span class="text-hc-primary/50 font-light">| {t('name')}</span>
          </h2>
          <p class="text-xl text-hc-secondary-text max-w-3xl leading-relaxed">
            {t('services_subtitle')}
          </p>
          <p class="text-xl text-hc-secondary-text max-w-3xl leading-relaxed">
            {t('services_description')}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
          <div class="group/card p-8 bg-hc-primary/5 rounded-2xl border border-hc-primary/10">
            <div class="flex flex-col gap-6">
              <div class="w-14 h-14 rounded-xl bg-hc-primary/10 flex items-center justify-center border border-hc-primary/20 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-hc-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                </svg>
              </div>
              <div>
                <h4 class="text-xl font-bold text-hc-text mb-3">{t('services_benefits_title1')}</h4>
                <p class="text-hc-secondary-text leading-relaxed">
                  {t('services_benefits_text1')}
                </p>
              </div>
            </div>
          </div>
          <div class="group/card p-8 bg-hc-primary/5 rounded-2xl border border-hc-primary/10">
            <div class="flex flex-col gap-6">
              <div class="w-14 h-14 rounded-xl bg-hc-primary/10 flex items-center justify-center border border-hc-primary/20 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-hc-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
              </div>
              <div>
                <h4 class="text-xl font-bold text-hc-text mb-3">{t('services_benefits_title2')}</h4>
                <p class="text-hc-secondary-text leading-relaxed">
                  {t('services_benefits_text2')}
                </p>
              </div>
            </div>
          </div>
          <div class="group/card p-8 bg-hc-primary/5 rounded-2xl border border-hc-primary/10">
            <div class="flex flex-col gap-6">
              <div class="w-14 h-14 rounded-xl bg-hc-primary/10 flex items-center justify-center border border-hc-primary/20 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-hc-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <h4 class="text-xl font-bold text-hc-text mb-3">{t('services_benefits_title3')}</h4>
                <p class="text-hc-secondary-text leading-relaxed">
                  {t('services_benefits_text3')}
                </p>
              </div>
            </div>
          </div>
        </div>
      <div class="text-center mb-12">
        <h3 class="text-3xl font-bold tracking-tight text-hc-text sm:text-5xl">
          {t('service_form_title')}
        </h3>
        <p class="mt-4 text-lg text-gray-600">
          {t('services_form_description')}
        </p>
      </div>
      <div class="flex justify-center">
        <div class="w-full max-w-2xl"> 
          <Form service="tech" />
          <EmailSuccessfulMessage />
        </div>
      </div>
      <div class="overflow-hidden py-10">
        <div class="flex flex-col md:flex-row bg-hc-desing items-center text-center gap-8 p-8 rounded-3xl text-hc-text z">
          <div class="flex flex-wrap gap-4 text-xs text-center  font-bold uppercase tracking-widest text-hc-text">
            <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-hc-primary"></span> {t('services_values')}</span>
            <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-hc-primary"></span> {t('services_values2')}</span>
            <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-hc-primary"></span> {t('services_values3')}</span>
            <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-hc-primary"></span> {t('services_values4')}</span>
          </div>
        </div>
      </div>
    </div>
</Section>
</MainLayout> 