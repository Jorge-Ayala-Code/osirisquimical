---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import { getLangHelpers } from '../../i18n/utils';

const { t, lang } = getLangHelpers(Astro.currentLocale);
---

<MainLayout>
    <Hero 
    id="privacy-policy"
    img='/../src/assets/images/heros/hero-privacy-polity.webp' 
    title={t('privacy_title')}
    text={t('seeMore')}/>
    <Section id="privacy-policy">
    <div class="max-w-4xl mx-auto">
      <div class="mb-12">
        <p class="mt-4 text-sm text-hc-secondary-text uppercase tracking-widest font-bold border-b border-hc-primary pb-2 inline-block">
          {t('privacy_header_company')}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 border-l-4 border-hc-primary bg-gray-50 shadow-sm">
          <h3 class="font-bold text-hc-text mb-2 uppercase text-xs tracking-wider">{t('privacy_resp_title')}</h3>
          <p class="text-hc-secondary-text text-sm leading-relaxed">
            {t('privacy_resp_text')}
          </p>
        </div>
        <div class="p-6 border-l-4 border-hc-primary bg-gray-50 shadow-sm">
          <h3 class="font-bold text-hc-text mb-2 uppercase text-xs tracking-wider">{t('privacy_purpose_title')}</h3>
          <p class="text-hc-secondary-text text-sm leading-relaxed">
            {t('privacy_purpose_text')}
          </p>
        </div>
      </div>
      <div class="max-w-4xl mx-auto py-10">
        <div class="mb-10">
          <h3 class="text-xl font-bold text-hc-text mb-4">{t('privacy_data_title')}</h3>
          <p class="text-hc-secondary-text leading-relaxed mb-4">
            {t('privacy_data_intro')}
          </p>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm text-hc-secondary-text">
            <li class="flex items-center"><span class="w-1.5 h-1.5 bg-hc-primary rounded-full mr-3"></span> {t('privacy_data_list1')}</li>
            <li class="flex items-center"><span class="w-1.5 h-1.5 bg-hc-primary rounded-full mr-3"></span> {t('privacy_data_list2')}</li>
            <li class="flex items-center"><span class="w-1.5 h-1.5 bg-hc-primary rounded-full mr-3"></span> {t('privacy_data_list3')}</li>
            <li class="flex items-center"><span class="w-1.5 h-1.5 bg-hc-primary rounded-full mr-3"></span> {t('privacy_data_list4')}</li>
          </ul>
        </div>
        <hr class="mb-10 border-gray-100">
        <div class="mb-10">
          <h3 class="text-xl font-bold text-hc-text mb-4">{t('privacy_arco_title')}</h3>
          <p class="text-hc-secondary-text leading-relaxed">
            {t('privacy_arco_intro')}
          </p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
            <div class="text-center p-3 bg-white border border-gray-200 rounded-lg">
              <strong class="block text-hc-primary text-sm">{t('privacy_arco_label1')}</strong>
              <span class="text-[10px] text-gray-500 uppercase">{t('privacy_arco_desc1')}</span>
            </div>
            <div class="text-center p-3 bg-white border border-gray-200 rounded-lg">
              <strong class="block text-hc-primary text-sm">{t('privacy_arco_label2')}</strong>
              <span class="text-[10px] text-gray-500 uppercase">{t('privacy_arco_desc2')}</span>
            </div>
            <div class="text-center p-3 bg-white border border-gray-200 rounded-lg">
              <strong class="block text-hc-primary text-sm">{t('privacy_arco_label3')}</strong>
              <span class="text-[10px] text-gray-500 uppercase">{t('privacy_arco_desc3')}</span>
            </div>
            <div class="text-center p-3 bg-white border border-gray-200 rounded-lg">
              <strong class="block text-hc-primary text-sm">{t('privacy_arco_label4')}</strong>
              <span class="text-[10px] text-gray-500 uppercase">{t('privacy_arco_desc4')}</span>
            </div>
          </div>
        </div>
        <div class="my-10 p-8 bg-gray-100/50 rounded-2xl border border-gray-200 text-center md:text-left">
          <h3 class="text-xl font-bold text-hc-text mb-4">
            {t('privacy_exercise_title')}
          </h3>
          <p class="text-hc-secondary-text leading-relaxed mb-6 text-sm">
            {t('privacy_exercise_text')}
          </p>
            <a href="mailto:contacto@osirisquimical.com" class="inline-block bg-hc-primary text-white px-8 py-3 rounded-md font-bold hover:bg-opacity-90 transition-all shadow-md text-sm uppercase tracking-wide">
              contacto@osirisquimical.com
            </a>
        </div>
        <div class="mb-8 space-y-6">
          <div>
            <h3 class="text-lg font-bold text-hc-text mb-2">{t('privacy_transfer_title')}</h3>
            <p class="text-hc-secondary-text text-sm leading-relaxed">
              {t('privacy_transfer_text')}
            </p>
          </div>
          <div>
            <h3 class="text-lg font-bold text-hc-text mb-2">{t('privacy_security_title')}</h3>
            <p class="text-hc-secondary-text text-sm leading-relaxed">
              {t('privacy_security_text')}
            </p>
          </div>
        </div>
        <p class="text-[10px] text-hc-primary mt-12 text-center uppercase tracking-widest border-t border-hc-primary pt-6">
          {t('privacy_footer_update')}
        </p>
      </div>
    </div>
  </Section>
</MainLayout> 